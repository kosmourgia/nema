#!/usr/bin/env bash
set -euo pipefail
module=$(cd -- "$(dirname -- "$0")/.." && pwd)
state="$module/.nema"
deps="$state/deps"
mkdir -p "$deps" "$state/builds" "$state/runs"
stage=$(mktemp -d "$state/builds/build.XXXXXX")
mkdir -p "$stage/classes" "$stage/flix/src" "$stage/flix/test" "$stage/flix/lib/external"
artifact="$deps/aeron-all-1.53.1.jar"
if [[ ! -f "$artifact" ]]; then
    curl --fail --location --retry 2 https://repo.maven.apache.org/maven2/io/aeron/aeron-all/1.53.1/aeron-all-1.53.1.jar -o "$artifact"
fi
expected=504ac8bc74ca63783a921da8e7ee96985b8422dd7cae003b9f629e75e97ae333
actual=$(sha256sum "$artifact")
[[ ${actual%% *} == "$expected" ]] || { echo 'Aeron artifact checksum mismatch' >&2; exit 1; }
mapfile -t java_sources < <(rg --files "$module/java" -g '*.java' | sort)
if (( ${#java_sources[@]} )); then
    javac -cp "$artifact" -d "$stage/classes" "${java_sources[@]}"
fi
bridge="$stage/nema-aeron-bridge.jar"
jar --create --file "$bridge" -C "$stage/classes" .
cp -R "$module/src/." "$stage/flix/src/"
if [[ -n ${NEMA_AERON_PROBE:-} ]]; then cp "$NEMA_AERON_PROBE" "$stage/flix/src/NegativeProbe.flix"; fi
if [[ -d "$module/test" ]]; then cp -R "$module/test/." "$stage/flix/test/"; fi
cp "$module/flix.toml" "$stage/flix/flix.toml"
ln -sfn "$artifact" "$stage/flix/lib/external/aeron-all-1.53.1.jar"
ln -sfn "$bridge" "$stage/flix/lib/external/nema-aeron-bridge.jar"
export NEMA_AERON_RUN=${NEMA_AERON_RUN:-$(mktemp -d "$state/runs/run.XXXXXX")}
cd "$stage/flix"
flix_jar=${NEMA_FLIX_JAR:-/usr/share/java/flix/flix.jar}
java_flags=(--add-opens java.base/jdk.internal.misc=ALL-UNNAMED --sun-misc-unsafe-memory-access=allow -XX:ActiveProcessorCount=2)
flix_args=(--no-install --threads 2)
case ${1:-help} in
    build|check|test) action=$1; shift; java "${java_flags[@]}" -jar "$flix_jar" "$action" "${flix_args[@]}" "$@" ;;
    run) shift; java "${java_flags[@]}" -jar "$flix_jar" run "${flix_args[@]}" "$@" ;;
    java) shift; java "${java_flags[@]}" -cp "$artifact:$bridge" "$@" ;;
    *) echo 'usage: modules/aeron/bin/aeron build|check|test|run [--entrypoint NAME]|java CLASS [ARGS]' ;;
esac
